rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /roteiros/{roteiroId} {
      // Ler próprios roteiros ou roteiros públicos da comunidade
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || resource.data.privado == false);

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // Dono edita tudo; qualquer usuário logado pode atualizar contadores de roteiros públicos
      allow update: if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || resource.data.privado == false
        );

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
